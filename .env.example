# Database
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# UploadThing
UPLOADTHING_TOKEN=

# Paystack
# Use a test secret key locally and a live secret key only in production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Demo seed (optional)
# Target a specific restaurant; otherwise the first restaurant with an active owner is used.
SEED_RESTAURANT_ID=
# Used only when Clerk password sign-in is enabled.
SEED_TEST_PASSWORD=PaperbagDemo!2026
# Safety override: leave unset. Only set to 1 if you intentionally want to seed a live Clerk instance.
ALLOW_LIVE_CLERK_SEED=
# Optional: choose a different env file for the seed script, e.g. .env.vercel.local
SEED_ENV_FILE=
