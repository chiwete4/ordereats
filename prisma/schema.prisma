generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  STAFF
  RIDER
}

enum RestaurantOrderStatus {
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum DeliveryStatus {
  WAITING_FOR_RIDER
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReviewTarget {
  RESTAURANT
  MENU_ITEM
  FEATURED_COMBO
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  firstName   String
  lastName    String
  phoneNumber String?
  dateOfBirth DateTime?
  allergies   String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders             Order[]
  restaurantStaff    RestaurantStaff[]
  assignedDeliveries Delivery[]        @relation("RiderDeliveries")
  reviews              Review[]
  complaints           CustomerComplaint[]
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  description String?
  phoneNumber String?
  address     String?
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  isOpen        Boolean  @default(true)
  isVerified    Boolean  @default(false)
  openingTime   String   @default("09:00")
  closingTime   String   @default("22:00")
  operatingDays Int[]    @default([1, 2, 3, 4, 5])
  timezone          String   @default("Africa/Lagos")
  payoutBankName       String?
  payoutBankCode       String?
  payoutAccountName    String?
  payoutAccountNumber  String?
  payoutRecipientCode    String?
  payoutRecipientId      String?
  paystackSubaccountCode String?
  paystackSubaccountId   String?
  payoutVerifiedAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff            RestaurantStaff[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  restaurantOrders RestaurantOrder[]
  featuredCombos   FeaturedCombo[]
  reviews          Review[]
  complaints       CustomerComplaint[]
  payouts          RestaurantPayout[]
}

model RestaurantStaff {
  id           String    @id @default(cuid())
  userId       String
  restaurantId String
  role         StaffRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([userId, restaurantId])
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems  MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable     Boolean @default(true)
  isArchived      Boolean @default(false)
  readyMin        Int     @default(1)
  readyMax        Int     @default(5)
  deliverySeconds Int     @default(45)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems          OrderItem[]
  featuredComboItems FeaturedComboItem[]
  reviews            Review[]
}

model FeaturedCombo {
  id              String   @id @default(cuid())
  restaurantId    String
  name            String
  readyMin        Int      @default(1)
  readyMax        Int      @default(5)
  deliverySeconds Int      @default(45)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      FeaturedComboItem[]
  reviews    Review[]

  @@index([restaurantId, sortOrder])
}

model FeaturedComboItem {
  id         String   @id @default(cuid())
  comboId    String
  menuItemId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  combo    FeaturedCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([comboId, menuItemId])
  @@index([menuItemId])
}

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  customerId        String
  subtotal          Decimal  @db.Decimal(10, 2)
  deliveryFee       Decimal  @db.Decimal(10, 2)
  serviceFee        Decimal  @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  deliveryLatitude  Float
  deliveryLongitude Float
  deliveryNote      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer         User              @relation(fields: [customerId], references: [id])
  restaurantOrders RestaurantOrder[]
  payment          Payment?
}

model RestaurantOrder {
  id           String                @id @default(cuid())
  orderId      String
  restaurantId String
  status       RestaurantOrderStatus @default(CONFIRMED)
  subtotal     Decimal               @db.Decimal(10, 2)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  order      Order       @relation(fields: [orderId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  delivery   Delivery?
  reviews    Review[]
  complaints CustomerComplaint[]
  payoutOrder RestaurantPayoutOrder?

  @@unique([orderId, restaurantId])
}

model OrderItem {
  id                String  @id @default(cuid())
  restaurantOrderId String
  menuItemId        String
  name              String
  unitPrice         Decimal @db.Decimal(10, 2)
  quantity          Int

  restaurantOrder RestaurantOrder @relation(fields: [restaurantOrderId], references: [id])
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
}

model Delivery {
  id                String         @id @default(cuid())
  restaurantOrderId String         @unique
  riderId           String?
  status            DeliveryStatus @default(WAITING_FOR_RIDER)
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  restaurantOrder RestaurantOrder @relation(fields: [restaurantOrderId], references: [id])
  rider           User?           @relation("RiderDeliveries", fields: [riderId], references: [id])
}

model Review {
  id                String       @id @default(cuid())
  restaurantId      String
  customerId        String
  restaurantOrderId String?
  target            ReviewTarget
  menuItemId        String?
  featuredComboId   String?
  rating            Int
  body              String?
  isRead            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantOrder RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id], onDelete: SetNull)
  menuItem        MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  featuredCombo   FeaturedCombo?   @relation(fields: [featuredComboId], references: [id], onDelete: SetNull)

  @@index([restaurantId, target, createdAt])
  @@index([menuItemId])
  @@index([featuredComboId])
}

model CustomerComplaint {
  id                String          @id @default(cuid())
  restaurantId      String
  customerId        String
  restaurantOrderId String?
  subject           String
  body              String
  status            ComplaintStatus @default(OPEN)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantOrder RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
}

model RestaurantPayout {
  id                   String       @id @default(cuid())
  restaurantId         String
  amount               Decimal      @db.Decimal(10, 2)
  currency             String       @default("NGN")
  reference            String       @unique
  paystackTransferCode String?
  paystackTransferId   String?
  status               PayoutStatus @default(PENDING)
  failureReason        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  completedAt          DateTime?

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     RestaurantPayoutOrder[]

  @@index([restaurantId, status, createdAt])
}

model RestaurantPayoutOrder {
  payoutId          String
  restaurantOrderId String
  createdAt         DateTime @default(now())

  payout          RestaurantPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  restaurantOrder RestaurantOrder  @relation(fields: [restaurantOrderId], references: [id], onDelete: Restrict)

  @@id([payoutId, restaurantOrderId])
  @@unique([restaurantOrderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  reference String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  provider  String        @default("paystack")
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}
